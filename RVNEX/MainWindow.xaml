<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RVNEX.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RVNEX">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource RvnexBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{ThemeResource RvnexBorderBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource RvnexSurfaceBrush}">
            <Grid Padding="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image x:Name="AppBrandLogo" Width="32" Height="32" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="RVNEX logo" />
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="RVNEX" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Offline VMware inventory analytics" FontSize="12" Foreground="{ThemeResource RvnexTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ConnectionsButton" Content="Connections" Click="ConnectionsButton_Click" />
                    <Button x:Name="StartCollectionButton" Content="Collect" Click="StartCollectionButton_Click" Style="{StaticResource RvnexPrimaryButtonStyle}" />
                    <Button x:Name="GetEmAllButton" Content="Get'em All" Click="GetEmAllButton_Click" />
                    <Button x:Name="ImportReportButton" Content="Import reports" Click="ImportReportButton_Click" />
                    <Button x:Name="SettingsToolbarButton" Content="Settings" Click="SettingsNavigationButton_Click" />
                    <Button x:Name="CancelCollectionButton" Content="Cancel" Click="CancelCollectionButton_Click" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{ThemeResource RvnexBorderBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource RvnexSurfaceAltBrush}">
            <Grid Padding="18,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="COLLECTION PROFILE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{ThemeResource RvnexTextSecondaryBrush}" VerticalAlignment="Center" />
                <ComboBox x:Name="ConnectionProfileSelector" Grid.Column="1" PlaceholderText="Choose a saved connection" SelectionChanged="ConnectionProfileSelector_SelectionChanged" />
                <TextBlock x:Name="SelectedConnectionSummary" Grid.Column="2" Text="Manage connections to collect inventory." Foreground="{ThemeResource RvnexTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{ThemeResource RvnexBorderBrush}" BorderThickness="0,0,1,0" Background="{ThemeResource RvnexSurfaceAltBrush}">
                <Grid Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="WORKSPACE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{ThemeResource RvnexTextTertiaryBrush}" Margin="8,4,0,8" />
                    <StackPanel Grid.Row="1" Spacing="2">
                        <Button x:Name="OverviewNavigationButton" Content="Overview" HorizontalAlignment="Stretch" Style="{StaticResource RvnexNavigationButtonStyle}" Click="OverviewNavigationButton_Click" />
                        <Button x:Name="InventoryNavigationButton" Content="Inventory explorer" HorizontalAlignment="Stretch" Style="{StaticResource RvnexNavigationButtonStyle}" Click="InventoryNavigationButton_Click" />
                        <Button x:Name="ReportsNavigationButton" Content="Reports &amp; history" HorizontalAlignment="Stretch" Style="{StaticResource RvnexNavigationButtonStyle}" Click="ReportsNavigationButton_Click" />
                        <Button x:Name="SettingsNavigationButton" Content="Settings &amp; diagnostics" HorizontalAlignment="Stretch" Style="{StaticResource RvnexNavigationButtonStyle}" Click="SettingsNavigationButton_Click" />
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="8,16,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="REPORT HISTORY" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource RvnexTextTertiaryBrush}" VerticalAlignment="Center" />
                        <Button x:Name="ClearComparisonButton" Grid.Column="1" Content="Clear" Padding="8,3" FontSize="11" Click="ClearComparisonButton_Click" />
                    </Grid>
                    <ListView x:Name="SnapshotListView" Grid.Row="3" SelectionMode="Extended" SelectionChanged="SnapshotListView_SelectionChanged" IsItemClickEnabled="False" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="3" Padding="2,7">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{ThemeResource RvnexTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="{ThemeResource RvnexTextTertiaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="4" Margin="8,8,8,4" Spacing="5">
                        <TextBlock x:Name="HistorySelectionText" Text="Select a report to explore. Ctrl-click reports to compare." FontSize="11" Foreground="{ThemeResource RvnexTextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Reports stay on this device." FontSize="10" Foreground="{ThemeResource RvnexTextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="WorkspaceHost" Padding="24,20" MaxWidth="1600" HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{ThemeResource RvnexBorderBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource RvnexSurfaceBrush}">
            <Grid Padding="16,8" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="CollectionProgress" Grid.Row="0" Grid.ColumnSpan="3" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
                <ProgressRing x:Name="ProgressIndicator" Grid.Row="1" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="StatusMessageText" Grid.Row="1" Grid.Column="1" Text="Import an RVTools workbook or start a collection." FontSize="12" Foreground="{ThemeResource RvnexTextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ConnectionStatusText" Grid.Row="1" Grid.Column="2" Text="Offline workspace ready" FontSize="12" Foreground="{ThemeResource RvnexTextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid x:Name="StartupSplash" Grid.RowSpan="4" Background="#171D21" Visibility="Visible"
              AutomationProperties.Name="RVNEX startup screen">
            <Border Width="380" Padding="32,28" CornerRadius="10"
                    Background="#20282D" BorderBrush="#3B4A50" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Image x:Name="SplashLogo" Width="88" Height="88" Stretch="Uniform" Visibility="Collapsed"
                           AutomationProperties.Name="RVNEX logo" />
                    <TextBlock Text="RVNEX" FontSize="25" FontWeight="SemiBold" Foreground="#EAF0F2"
                               HorizontalAlignment="Center" />
                    <Border Width="34" Height="3" CornerRadius="2" Background="#3CC8BE" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SplashVersion" Text="Version 1.0.0" FontSize="13" Foreground="#B2C0C4" HorizontalAlignment="Center" />
                    <TextBlock Text="Amirkhatam Pedram" FontSize="13" Foreground="#EAF0F2" HorizontalAlignment="Center" />
                    <TextBlock Text="AKPedram.com" FontSize="13" Foreground="#3CC8BE" HorizontalAlignment="Center" />
                    <TextBlock Text="Powered By Me And AI :)" FontSize="12" Foreground="#91A2A7" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
